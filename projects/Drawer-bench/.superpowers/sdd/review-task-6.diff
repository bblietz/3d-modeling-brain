+    assert abs(_sb.min.Y - _fb.max.Y) < 1e-6, _sfx                 # starts at the front's back
+assert BACK_Y0 - BOX_Y0 - SLIDE_LEN >= UM_REAR_CLEAR, BACK_Y0 - BOX_Y0 - SLIDE_LEN
+
 # --- assembly ---------------------------------------------------------------
 assembly = (post_fl + post_fr + post_rl + post_rr
